{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "outDir": "dist",
    "rootDir": ".",
    "types": [
      "node"
    ],
    "skipLibCheck": true
  },
  "include": [
    "*.ts",
    "models/**/*.ts",
    "routers/**/*.ts"
  ]
}
